# Byte code
__pycache__/
*.py[cod]

# Tool caches
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
build/
dist/
.eggs/
*.egg-info/

# Environments
.venv/
env/

# Vault working directories produced by running bk from the repo root.
# A vault's own disposables (.brain/index.db and its -shm/-wal siblings) are
# covered by the .gitignore that `bk init` writes into the vault itself.
work/
outputs/

# Agent scaffolding: worktrees nested in the repo would otherwise be staged as
# broken gitlinks by `git add -A`. Only worktrees — .claude/settings.json and
# .claude/skills are legitimate tracked content.
.claude/worktrees/

# macOS
.DS_Store
