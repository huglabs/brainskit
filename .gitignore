# Byte code
__pycache__/
*.py[cod]

# Tool caches
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
build/
dist/
.eggs/
*.egg-info/

# Environments
.venv/
env/

# Vault working directories produced by running bk from the repo root.
# A vault's own disposables (.brain/index.db and its -shm/-wal siblings) are
# covered by the .gitignore that `bk init` writes into the vault itself.
work/
outputs/
# The comparison graph an external graphify run leaves behind: ~17 MB of
# regenerated JSON/HTML, derived from this tree and never an input to it.
graphify-out/

# Agent scaffolding: worktrees nested in the repo would otherwise be staged as
# broken gitlinks by `git add -A`. Only worktrees — .claude/settings.json and
# .claude/skills are legitimate tracked content.
.claude/worktrees/

# macOS
.DS_Store

# Benchmark corpora: real repositories cloned at pinned commits, plus the
# LOCOMO release. Declared at the *root* rather than only in benchmarks/,
# because the extractor reads the ignore file at its scan root and never
# descends into nested ones -- so a nested rule left ~1,400 files of ripgrep
# and commons-lang in this project's own code graph, where they took every
# top hub slot.
benchmarks/corpus-repos/
benchmarks/memory/locomo10.json
# Derived from locomo10.json by run_locomo_graphify.py -- ~7,000 markdown turns
# regenerated on every run, and the same scan-root reasoning applies.
benchmarks/memory/graphify-corpora/
