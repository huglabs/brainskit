{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brainskit.page.v1",
  "type": "object",
  "required": ["id", "type", "title", "aliases", "sources", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["source", "entity", "concept", "synthesis", "system"]
    },
    "title": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "code_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
