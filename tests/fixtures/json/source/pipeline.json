{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline",
  "type": "object",
  "required": ["stages"],
  "properties": {
    "name": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    }
  }
}
